class Solution {
    /**
      Approach:  Perform BFS traversal using queue. Find max value for ech level and add it to the result.
      Time: O(N) where N is number of nodes
      Space: O(N/2)=> O(N)
     */
    List<Integer> result;

    public List<Integer> largestValues(TreeNode root) {
        result = new ArrayList<>();
        /*      if (root == null)
            return result;
        
        Queue<TreeNode> q = new LinkedList<>();
        q.add(root);
        while (!q.isEmpty()) {
            int size = q.size();
            int maxVal = Integer.MIN_VALUE;
            for (int i = 0; i < size; i++) {
                TreeNode curr = q.poll();
                maxVal = Math.max(maxVal, curr.val);
        
                if (curr.left != null)
                    q.add(curr.left);
                if (curr.right != null)
                    q.add(curr.right);
            }
            result.add(maxVal);
        }
        return result;
        */
        dfs(root, 0);
        return result;

    }

/**
Time: O(n)
Space: o(h)
 */
    private void dfs(TreeNode curr, int level) {
        //base
        if (curr == null)
            return;

        //logic
        if (result.size() == level) {
            result.add(curr.val);
        } else {
            result.set(level, Math.max(curr.val, result.get(level)));
        }
        dfs(curr.left, level + 1);
        dfs(curr.right, level + 1);
    }
}